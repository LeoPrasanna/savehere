# Copy this file to .env and fill in your real values
# Never commit .env to git

# Anthropic (Claude Haiku - summarization + tagging)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Whisper - transcription) — leave blank if using local Whisper
OPENAI_API_KEY=your_openai_api_key_here

# Apify (Instagram scraper) — leave blank if using yt-dlp
APIFY_API_KEY=your_apify_api_key_here

# Supabase (dashboard → Settings → API Keys). New key system:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "Publishable" key (sb_publishable_...) — safe to share:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Public JWKS endpoint to verify ECC-signed access tokens (defaults to this path under URL):
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Backend-only — NEVER ship to the mobile app. A "Secret" key (sb_secret_...):
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# App
ENV=development

# Per-user AI actions allowed per UTC day (ask + recipe + workout + (re)summarize all
# count). The FREE-tier cost ceiling; lower it to tighten the budget without a deploy.
AI_DAILY_LIMIT=30
# Paid-tier daily limit — applies to users whose JWT has app_metadata.tier == "pro"
# (set server-side by the RevenueCat/IAP webhook at launch). Placeholder until pricing.
AI_PRO_DAILY_LIMIT=100

# Production only — comma-separated web origins allowed by CORS (defaults to *).
# Set to the deployed web app's domain once it's known, e.g. https://savehere.app
ALLOWED_ORIGINS=*

# Optional DB override. Defaults to local SQLite; set to a Postgres URL in prod
# (lands with auth). The driver is auto-selected from the scheme.
# DATABASE_URL=postgresql://user:pass@host:5432/savehere
