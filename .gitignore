# ── Secrets ────────────────────────────────────────────────
.env

# MCP server config. `claude mcp add --scope project` writes the server's
# credentials here in plaintext — an auth header or token, straight into the
# repo. Ignored so a project-scoped install can't be committed by accident.
# (The default `--scope local` writes to ~/.claude.json instead and never
# touches the repo, which is the safer way to add one.)
.mcp.json

# ── Agent skills (npx skills add) ───────────────────────────
# `skills-lock.json` IS committed — it records the source repo and content hash,
# so any environment can restore the same skill with `npx skills add`. These two
# are the regenerable halves, same split as package-lock.json vs node_modules:
#   .agents/       ~600 KB of vendored third-party docs and assets
#   .claude/skills/ symlinks written with ABSOLUTE machine paths — committing
#                   one would point at /c/Users/<this machine>/… and break
#                   everywhere else, Codespaces included.
.agents/
.claude/skills/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Database (local dev only, never commit) ─────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / Expo ─────────────────────────────────────────────
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/dist-*/
mobile/web-build/
mobile/.env

# Root-level stray npm install (project is Python backend + mobile/ — there is no
# root npm package; the supabase CLI got pulled in here and must not be committed).
/node_modules/
/package.json
/package-lock.json

# ── Expo native build artefacts ─────────────────────────────
mobile/ios/
mobile/android/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ──────────────────────────────────────────────────
.vscode/
.idea/

# ── Logs ────────────────────────────────────────────────────
*.log

# ── yt-dlp temp downloads ───────────────────────────────────
downloads/
*.mp4
*.mp3
*.wav
*.webm
