{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savehere-api-staging.onrender.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://REPLACE-WITH-SAVEHERE-DEV.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_REPLACE_WITH_SAVEHERE_DEV_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savehere-api-staging.onrender.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://REPLACE-WITH-SAVEHERE-DEV.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_REPLACE_WITH_SAVEHERE_DEV_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savehere-api-prod.onrender.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://lukmwwcilrjqqtgqbynq.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_VqxG1D40q4az4nGGIKtDAw_hDwARxou"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "ascApiKeyPath": "path/to/AuthKey.p8",
        "ascApiKeyIssuerId": "YOUR_ISSUER_ID",
        "ascApiKeyId": "YOUR_KEY_ID"
      }
    }
  }
}
