{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "autoIncrement": true,
      "channel": "preview"
    },
    "testflight": {
      // TestFlight needs STORE distribution — `preview` is ad-hoc (registered
      // devices only) and its IPA cannot be uploaded. Points at the STAGING env
      // on purpose: the `production` env var EXPO_PUBLIC_API_URL is
      // https://savehere-api-prod.onrender.com, a service that does not exist yet
      // (commented out in render.yaml). A production-profile TestFlight build
      // would ship testers a dead API. Switch to production the day it is live.
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "testflight": {},
    "production": {
      "ios": {
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "ascApiKeyPath": "path/to/AuthKey.p8",
        "ascApiKeyIssuerId": "YOUR_ISSUER_ID",
        "ascApiKeyId": "YOUR_KEY_ID"
      }
    }
  }
}
