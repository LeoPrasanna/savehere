{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      // USE_CCACHE=0 is REQUIRED for iOS, not a preference. React Native sets
      // CC/LD to "$(REACT_NATIVE_PATH)/scripts/xcode/ccache-clang.sh" on the
      // PROJECT build configuration (node_modules/react-native/scripts/cocoapods/
      // utils.rb), so it lands on every target — but REACT_NATIVE_PATH is only
      // defined by the Pods xcconfig, which expo-share-intent's ShareExtension
      // target does not get. It expands to empty and the build dies with
      // "unable to spawn process '/../../node_modules/.../ccache-clang.sh'".
      // Costs a cold compile per build; the alternative is no iOS build at all.
      // SENTRY_DISABLE_AUTO_UPLOAD kills a build otherwise. @sentry/react-native's
      // Expo plugin runs sentry-cli inside the "Run fastlane" phase to upload
      // source maps, which needs an org slug AND an auth token — neither of
      // which exists here. Without them sentry-cli exits non-zero and takes the
      // whole build with it (build 107ceb3c, 2026-09-10, the first build after
      // Sentry landed in #100 — the defect was invisible until something
      // actually compiled it).
      //
      // ⚠️ THE COST IS REAL: no source maps means Sentry shows MINIFIED stack
      // traces. Crashes are still reported, but reading one means matching
      // bundle offsets by hand. Remove this the day SENTRY_AUTH_TOKEN and the
      // org/project slugs are set (eas secret:create + the plugin config in
      // app.json) — the upload is worth having, it is just not worth blocking
      // every build on.
      "env": { "USE_CCACHE": "0", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "distribution": "internal",
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "autoIncrement": true,
      "channel": "preview"
    },
    "testflight": {
      // USE_CCACHE=0 is REQUIRED for iOS, not a preference. React Native sets
      // CC/LD to "$(REACT_NATIVE_PATH)/scripts/xcode/ccache-clang.sh" on the
      // PROJECT build configuration (node_modules/react-native/scripts/cocoapods/
      // utils.rb), so it lands on every target — but REACT_NATIVE_PATH is only
      // defined by the Pods xcconfig, which expo-share-intent's ShareExtension
      // target does not get. It expands to empty and the build dies with
      // "unable to spawn process '/../../node_modules/.../ccache-clang.sh'".
      // Costs a cold compile per build; the alternative is no iOS build at all.
      // SENTRY_DISABLE_AUTO_UPLOAD kills a build otherwise. @sentry/react-native's
      // Expo plugin runs sentry-cli inside the "Run fastlane" phase to upload
      // source maps, which needs an org slug AND an auth token — neither of
      // which exists here. Without them sentry-cli exits non-zero and takes the
      // whole build with it (build 107ceb3c, 2026-09-10, the first build after
      // Sentry landed in #100 — the defect was invisible until something
      // actually compiled it).
      //
      // ⚠️ THE COST IS REAL: no source maps means Sentry shows MINIFIED stack
      // traces. Crashes are still reported, but reading one means matching
      // bundle offsets by hand. Remove this the day SENTRY_AUTH_TOKEN and the
      // org/project slugs are set (eas secret:create + the plugin config in
      // app.json) — the upload is worth having, it is just not worth blocking
      // every build on.
      "env": { "USE_CCACHE": "0", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      // TestFlight needs STORE distribution — `preview` is ad-hoc (registered
      // devices only) and its IPA cannot be uploaded. Points at the STAGING env
      // on purpose: the `production` env var EXPO_PUBLIC_API_URL is
      // https://savehere-api-prod.onrender.com, a service that does not exist yet
      // (commented out in render.yaml). A production-profile TestFlight build
      // would ship testers a dead API. Switch to production the day it is live.
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      // USE_CCACHE=0 is REQUIRED for iOS, not a preference. React Native sets
      // CC/LD to "$(REACT_NATIVE_PATH)/scripts/xcode/ccache-clang.sh" on the
      // PROJECT build configuration (node_modules/react-native/scripts/cocoapods/
      // utils.rb), so it lands on every target — but REACT_NATIVE_PATH is only
      // defined by the Pods xcconfig, which expo-share-intent's ShareExtension
      // target does not get. It expands to empty and the build dies with
      // "unable to spawn process '/../../node_modules/.../ccache-clang.sh'".
      // Costs a cold compile per build; the alternative is no iOS build at all.
      // SENTRY_DISABLE_AUTO_UPLOAD kills a build otherwise. @sentry/react-native's
      // Expo plugin runs sentry-cli inside the "Run fastlane" phase to upload
      // source maps, which needs an org slug AND an auth token — neither of
      // which exists here. Without them sentry-cli exits non-zero and takes the
      // whole build with it (build 107ceb3c, 2026-09-10, the first build after
      // Sentry landed in #100 — the defect was invisible until something
      // actually compiled it).
      //
      // ⚠️ THE COST IS REAL: no source maps means Sentry shows MINIFIED stack
      // traces. Crashes are still reported, but reading one means matching
      // bundle offsets by hand. Remove this the day SENTRY_AUTH_TOKEN and the
      // org/project slugs are set (eas secret:create + the plugin config in
      // app.json) — the upload is worth having, it is just not worth blocking
      // every build on.
      "env": { "USE_CCACHE": "0", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    // ascAppId is the App Store Connect "Apple ID" — a public identifier (it is
    // the number in every apps.apple.com URL), NOT a credential. Same record for
    // both profiles: one app, two channels.
    //
    // The ascApiKey* fields that used to sit here were PLACEHOLDERS
    // ("path/to/AuthKey.p8"), which is worse than absent — eas submit would have
    // tried to read that path and failed. Omitted on purpose: EAS prompts for an
    // Apple login instead. Fill them in only when submission needs to run
    // unattended in CI, and the .p8 must NOT be committed.
    "testflight": {
      "ios": {
        "ascAppId": "6810128841"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6810128841"
      }
    }
  }
}
