# Copy this file to mobile/.env and fill in your real values.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle — never put a secret
# (service_role key, JWT secret) here; those are backend-only.

# Backend API base URL. Defaults to http://localhost:8000 if unset.
# In a Codespace, set this to the forwarded backend URL (see docs/REMOTE_DEV.md).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (auth). Project URL + the "Publishable" key (sb_publishable_...) — safe
# to ship in the app. Dashboard → Settings → API Keys. NEVER put a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
